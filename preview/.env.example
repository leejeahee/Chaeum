# ─────────────────────────────────────────────────────────────
# Chaeum — 환경변수 템플릿 (팀 공유용, Git에 포함됩니다)
# 이 파일을 복사해서 .env 파일로 만들고, 실제 키 값을 채워주세요.
#   cp .env.example .env
# ─────────────────────────────────────────────────────────────

# Supabase 프로젝트 설정
# Supabase 대시보드 → Settings → API에서 확인
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON=your_supabase_anon_public_key

# Kakao Maps JavaScript API 키
# https://developers.kakao.com → 앱 → 앱 키 → JavaScript 키
VITE_KAKAO_MAP_KEY=your_kakao_javascript_app_key
